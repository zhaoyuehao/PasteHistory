{
  "name": "pastehistory-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "npm run build -- --base /",
    "build:workbuddy": "npm run snapshot && tsc --noEmit && node scripts/prepare-download.mjs",
    "test": "tsx --test src/*.test.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "tsx": "^4.20.6"
  }
}
